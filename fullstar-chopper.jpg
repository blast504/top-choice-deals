                        /* activate first one */
                        CarouselButton.objects.byId[1].activate();

                        /* Listen to slide changes */
                        A.on("a:carousel:" + CAROUSEL_NAME + ":change:pageNumber", function (data) {
                            var newCarouselButton = CarouselButton.objects.byId[data.newValue];

                                               <span id="primeExclusivePricingMessage" class="a-size-base">    <script defer="" src="./fullstar-chopper_files/SFXInjectableScript.js.download"></script>
                                <a id="pep-additional-signup-link" data-campaign-id="PrimeExclusiveMario_DetailPage_Desktop_PrimeSavings" data-redirect-url="/gp/product/B0764HS4SL?psc=1" class="a-link-normal" href="https://www.amazon.com/hp/wlp/pipeline/membersignup?clientId=PrimeExclusiveMario&amp;ingressId=DetailPage&amp;redirectURL=L2RwL0IwNzY0SFM0U0w&amp;redirectQueryParams=cHNjPTE&amp;cancelRedirectURL=L2RwL0IwNzY0SFM0U0w&amp;cancelRedirectQueryParams=cHNjPTE&amp;primeCampaignId=PrimeExclusiveMario_DetailPage_Desktop_PrimeSavings&amp;asin=B0764HS4SL&amp;refAsin=B0764HS4SL&amp;benefitOptimizationId=PrimeExclusiveMario&amp;wait=1">       <span>Join Prime to buy this item at </span><span class="a-size-base">$26.99</span>     </a> <script type="text/javascript">(function(f) {var _np=(window.P._namespace("DetailPagePrimeExclusivePricingTemplates"));if(_np.guardFatal){_np.guardFatal(f)(_np);}else{f(_np);}}(function(P) {
                                    P.when("sfx-injectable").execute("pep-additional-attach-wlp-signup", async (injectableAPI) => {
                                    const pepSignupLink = document.getElementById("pep-additional-signup-link");
                                    // Dynamic values come from HTML-escaped data-* attributes (not inlined into JS literals)
                                    const pepWlpParams = {
                                    clientId: "PrimeExclusiveMario",
                                    ingressId: "DetailPage",
                                    primeCampaignId: pepSignupLink.dataset.campaignId,
                                    benefitOptimizationId: "PrimeExclusiveMario",
                                    redirectURL: pepSignupLink.dataset.redirectUrl,
                                    cancelRedirectURL: pepSignupLink.dataset.redirectUrl
                                    }
                                    let experienceUUID = injectableAPI.initiate(pepWlpParams, {});

                                    // Replace the fallback navigation with the injectable on click
                                    pepSignupLink.onclick = (event) => {
                                    event.preventDefault();
                                    injectableAPI.show(experienceUUID);
                                    }

                                    // Re-open the injectable after a sign-in redirect (loadInjectable=[clientId]_[ingressId])
                                    const queryParams = new URLSearchParams(window.location.search);
                                    const loadInjectableIds = queryParams.get("loadInjectable");
                                    if (loadInjectableIds) {
                                    const [redirectClientId, redirectIngressId] = loadInjectableIds.split("_");
                                    if (redirectClientId === pepWlpParams.clientId && redirectIngressId === pepWlpParams.ingressId) {
                                    injectableAPI.show(experienceUUID);
                                    }
                                    }
                                    })
                                }));</script>     </span>                                  </div>

                        /* create carousel controls */
                        var $carouselBtns = $(safeClassSelector(GOTO_BTN_CLASS_NAME));
                        var btns = $carouselBtns.map(function(i, btnElem) {
                            return new CarouselButton(i + 1, btnElem);

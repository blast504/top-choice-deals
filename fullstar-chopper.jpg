                                                           <div class="a-row"> <div class="a-column a-span12 a-text-left">               <style type="text/css">
    #buybox .a-accordion .a-accordion-active .a-price[data-a-size=l].reinventPriceAccordionT2 .a-price-whole {
        font-size: 28px !important;
    }
    #buybox .a-accordion .a-accordion-active .a-price[data-a-size=l].reinventPriceAccordionT2 .a-price-fraction,
    #buybox .a-accordion .a-accordion-active .a-price[data-a-size=l].reinventPriceAccordionT2 .a-price-symbol {
        top: -0.75em;
        font-size: 13px;
    }
    /* Hide Rufus ingress in collapsed accordion rows, show only when active */
    #buybox .a-accordion .rufus-ingress-div-block,
    #buybox .a-accordion .rufus-ingress-badge{
        display: none;
    }
    #buybox .a-accordion .a-accordion-active .rufus-ingress-div-block,
    #buybox .a-accordion .a-accordion-active .rufus-ingress-badge{
        display: block;
    }
</style>

                  <div class="a-spacing-top-mini apex-core-price-identifier">
               <style>
            /* container aligning Price with PPU and Ingress */
            .price-rufus-price-history-ingress {
                display: flex;
                align-items: baseline;
                gap: 4px;
            }
            /* T2/T3: center alignment for badge on it's own */
            .price-rufus-price-history-ingress.has-badge-right {
                align-items: center;
            }
            /* Used for text and badge with PPU */
            .price-rufus-price-history-ingress.has-ppu {
                align-items: center;
                flex-wrap: wrap;
            }
            /* Force badge to new line */
            .price-rufus-price-history-ingress.has-ppu.has-badge-below > .rufus-ingress-div-block {
                flex-basis: 100%;
            }
            .right-of-price-stack {
                display: flex;
                flex-direction: column;
                align-items: flex-start;
                font-weight: normal;
                /* child elements have own height, this is to remove excess spacing between to reduce vertical height*/
                line-height: 0;
